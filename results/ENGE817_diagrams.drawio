<mxfile host="Electron" agent="ENGE817">
  <diagram name="Research methodology" id="methodology">
    <mxGraphModel dx="1100" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="660" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="data" value="&lt;b&gt;Dataset: ISCXVPN2016&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;Scenario A1, 15-second flow timeout&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="30" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="grp" value="&lt;b&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;4.2  Preprocessing&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="116" width="600" height="232" as="geometry" /></mxCell>
        <mxCell id="p1" value="4.2.1   Recode undefined values (−1) as missing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="54" y="150" width="552" height="30" as="geometry" /></mxCell>
        <mxCell id="p2" value="4.2.2   Remove empty flow records" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="54" y="186" width="552" height="30" as="geometry" /></mxCell>
        <mxCell id="p3" value="4.2.3   Remove exact duplicate records" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="54" y="222" width="552" height="30" as="geometry" /></mxCell>
        <mxCell id="p4" value="4.2.4   Exclude features whose values contradict their definitions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="54" y="258" width="552" height="30" as="geometry" /></mxCell>
        <mxCell id="p5" value="4.2.5   Encode the class label (VPN = 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="54" y="294" width="552" height="30" as="geometry" /></mxCell>
        <mxCell id="split" value="4.2.6   Stratified split by class" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="386" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="train" value="&lt;b&gt;Training set&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="230" height="44" as="geometry" /></mxCell>
        <mxCell id="test" value="&lt;b&gt;&lt;font color=&quot;#A33A36&quot;&gt;Test set&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;reserved from model selection&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="230" height="58" as="geometry" /></mxCell>
        <mxCell id="mgrp" value="&lt;b&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;4.3  Model&lt;/font&gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B3B3B3;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="230" height="232" as="geometry" /></mxCell>
        <mxCell id="m1" value="&lt;b&gt;Baseline XGBoost&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;library defaults&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="564" width="198" height="48" as="geometry" /></mxCell>
        <mxCell id="m2" value="&lt;b&gt;Randomised search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;scored by five-fold&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;cross-validation&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="628" width="198" height="56" as="geometry" /></mxCell>
        <mxCell id="m3" value="&lt;b&gt;Final model, fixed&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="76" y="700" width="198" height="42" as="geometry" /></mxCell>
        <mxCell id="ev" value="&lt;b&gt;4.4  Evaluation&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="810" width="300" height="42" as="geometry" /></mxCell>
        <mxCell id="sq1" value="&lt;b&gt;SQ1 — detection performance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;accuracy, precision, recall,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;F1, ROC-AUC, confusion matrix&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="sq2" value="&lt;b&gt;SQ2 — feature contribution&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;gain, permutation importance,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B6B7A&quot;&gt;SHAP, correlation structure&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="890" width="250" height="70" as="geometry" /></mxCell>
